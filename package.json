{
	"name": "react-testing",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"engines": {
		"bun": ">=1.3"
	},
	"scripts": {
		"preinstall": "bunx only-allow bun",
		"check-updates": "bun outdated",
		"format": "prettier -w .",
		"dev": "bun --bun vite",
		"build": "bun --bun tsc -b && bun --bun vite build",
		"lint": "bun --bun eslint .",
		"preview": "bun --bun vite preview",
		"type-check": "bun --bun tsc --noEmit"
	},
	"dependencies": {
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"swr": "^2.3.6"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"eslint": "^10.4.1",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.6.0",
		"prettier": "^3.8.4",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.61.0",
		"vite": "^8.0.16"
	}
}
